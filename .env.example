# .env.example

# AI Provider Selection ('gemini' | 'ollama')
AI_PROVIDER=gemini
# Optional Fallback AI Provider ('ollama' | 'gemini')
AI_FALLBACK_PROVIDER=

# Gemini Configurations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Cloud / Server Configurations
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Supabase Configurations (optional, client-side/server-side defaults to mock memory store)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
